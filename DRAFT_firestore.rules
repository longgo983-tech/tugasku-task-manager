rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all (Pillar 4.1)
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Helper Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidTask(data) {
      return data.keys().hasAll(['userId', 'title', 'category', 'priority', 'status', 'reminderEnabled', 'dailyRecurring'])
        && data.keys().hasOnly(['userId', 'title', 'description', 'category', 'priority', 'status', 'dueDate', 'dueTime', 'reminderEnabled', 'reminderTime', 'dailyRecurring', 'completedAt', 'createdAt', 'updatedAt', 'googleEventId', 'calendarSynced', 'lastCalendarSync', 'isDeleted', 'deletedAt'])
        && data.userId == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && (!('description' in data) || (data.description is string && data.description.size() <= 1000))
        && data.category in ['work', 'personal', 'study', 'health', 'urgent', 'general']
        && data.priority in ['low', 'medium', 'high', 'urgent']
        && data.status in ['pending', 'in_progress', 'completed']
        && data.reminderEnabled is bool
        && data.dailyRecurring is bool
        && (!('dueDate' in data) || (data.dueDate is string && data.dueDate.size() <= 30))
        && (!('dueTime' in data) || (data.dueTime is string && data.dueTime.size() <= 10))
        && (!('reminderTime' in data) || (data.reminderTime is string && data.reminderTime.size() <= 10))
        && (!('completedAt' in data) || (data.completedAt is string && data.completedAt.size() <= 50))
        && (!('googleEventId' in data) || (data.googleEventId is string && data.googleEventId.size() <= 256))
        && (!('calendarSynced' in data) || data.calendarSynced is bool)
        && (!('lastCalendarSync' in data) || (data.lastCalendarSync is string && data.lastCalendarSync.size() <= 50))
        && (!('isDeleted' in data) || data.isDeleted is bool)
        && (!('deletedAt' in data) || (data.deletedAt is string && data.deletedAt.size() <= 50))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    function isValidUserSettings(data) {
      return data.keys().hasAll(['userId', 'dailyReminderTime', 'soundEnabled', 'morningBriefEnabled'])
        && data.keys().hasOnly(['userId', 'dailyReminderTime', 'soundEnabled', 'morningBriefEnabled', 'updatedAt'])
        && data.userId == request.auth.uid
        && data.dailyReminderTime is string && data.dailyReminderTime.size() <= 10
        && data.soundEnabled is bool
        && data.morningBriefEnabled is bool
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    // User Subcollections
    match /users/{userId} {
      allow read, write: if false;

      match /tasks/{taskId} {
        allow get: if isSignedIn() && request.auth.uid == userId && isValidId(taskId);
        allow list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && request.auth.uid == userId && isValidId(taskId) && isValidTask(incoming());
        allow update: if isSignedIn() && request.auth.uid == userId && isValidId(taskId) && isValidTask(incoming()) && incoming().userId == existing().userId;
        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(taskId);
      }

      match /settings/{settingId} {
        allow get: if isSignedIn() && request.auth.uid == userId && isValidId(settingId);
        allow list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && request.auth.uid == userId && isValidId(settingId) && isValidUserSettings(incoming());
        allow update: if isSignedIn() && request.auth.uid == userId && isValidId(settingId) && isValidUserSettings(incoming()) && incoming().userId == existing().userId;
        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(settingId);
      }
    }
  }
}
